#! /bin/sh
#PBS -N wrs_startcycle_%CYC%
#PBS -j oe
#PBS -S /bin/bash
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:45:00
#PBS -l place=shared,select=1:ncpus=1:mem=500MB
#PBS -l debug=true

model=wfs
%include <head.h>
%include <envir-p1.h>

set -x

export NET=%NET:wfs%
export CDUMP=%RUN:wfs%

export cyc=%CYC%
export cycle=t%CYC%z

${HOMEwfs}/jobs/JWAMIPE_STARTCYCLE

%include <tail.h>
%manual

%end
